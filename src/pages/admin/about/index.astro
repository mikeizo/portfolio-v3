---
import { fetchData } from '@/utils/mongodb'

import Admin from '@/layouts/Admin.astro'
import AdminAboutList from '@/components/admin/pages/AdminAboutList.vue'

const about = (await fetchData('about', { sort: 'yearFrom', order: -1 })) ?? []
---

