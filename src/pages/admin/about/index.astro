---
import type { AboutType } from '@/types/portfolio'
import { fetchData } from '@/utils/mongodb'

import Admin from '@/layouts/Admin.astro'
import AdminAboutList from '@/components/admin/pages/about/AdminAboutList.vue'

const aboutData = ((await fetchData('about', { sort: 'year', order: 1 })) ??
  []) as AboutType[]
const path = Astro.url.pathname
---

<Admin>
  <AdminAboutList data={aboutData} path={path} client:load />
</Admin>
