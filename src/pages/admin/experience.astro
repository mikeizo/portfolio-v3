---
import { fetchData } from '@/utils/mongodb'

import Admin from '@/layouts/Admin.astro'
import ExperiencePage from '@/components/admin/pages/Experience.vue'

const experiences =
  (await fetchData('experience', { sort: 'name', order: 1 })) ?? []
---

<Admin>
  <ExperiencePage data={experiences} client:load />
</Admin>
