---
import { fetchDataById } from '@/utils/mongodb'

import AdminNew from '@/layouts/AdminNew.astro'
import AdminWorkForm from '@/components/admin-new/pages/AdminWorkForm.vue'

const { id } = Astro.params

// A missing record returns null; a malformed id makes fetchDataById throw.
// Treat both as not-found so the form never receives null.
let workData = null
try {
  workData = await fetchDataById('work', id)
} catch {
  workData = null
}

if (!workData) return Astro.redirect('/admin-new/work')
---

<AdminNew>
  <AdminWorkForm data={workData} id={id} client:load />
</AdminNew>
