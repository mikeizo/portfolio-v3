---
import { fetchData } from '@/utils/mongodb'

import AdminNew from '@/layouts/AdminNew.astro'
import ExperiencePage from '@/components/admin-new/pages/Experience.vue'

const experiences =
  (await fetchData('experience', { sort: 'name', order: 1 })) ?? []
---

<AdminNew>
  <ExperiencePage data={experiences} client:load />
</AdminNew>
