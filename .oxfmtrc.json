{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "none",
  "printWidth": 100,
  "singleAttributePerLine": true,
  "vueIndentScriptAndStyle": true,
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    "build/",
    ".astro/",
    ".claude/",
    ".playwright/",
    ".output/",
    ".vscode/",
    ".vercel/",
    "CLAUDE.md"
  ]
}
